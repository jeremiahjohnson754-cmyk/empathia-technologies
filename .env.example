# Empathia production starter — environment. Copy to .env for docker compose; the non-container path (node scripts/dev.mjs)
# generates its own local values under .local/ and needs none of this. Never commit .env.

# --- runtime
NODE_ENV=development            # production refuses AUTH_MODE=dev, the synthetic seed and missing secrets
AUTH_MODE=dev                   # dev = the development identity provider; production = oidc (to be implemented: see docs/security)
HOST=127.0.0.1
PORT=4100
LOG_LEVEL=info

# --- database (the owner runs migrations; the runtime role is subject to row-level security)
DATABASE_URL=postgres://empathia_owner:CHANGE_ME@127.0.0.1:55432/empathia
APP_DATABASE_URL=postgres://empathia_app:CHANGE_ME@127.0.0.1:55432/empathia
POSTGRES_PASSWORD=CHANGE_ME
EMPATHIA_OWNER_PASSWORD=CHANGE_ME
EMPATHIA_APP_PASSWORD=CHANGE_ME

# --- tokens (HS256 in development; production replaces the issuer with OIDC RS256 + JWKS)
JWT_SECRET=CHANGE_ME_TO_32_OR_MORE_RANDOM_BYTES
JWT_ISSUER=empathia-dev-idp
JWT_AUDIENCE=empathia-enterprise-api
TOKEN_TTL_SECONDS=900

# --- HTTP
CORS_ORIGINS=http://127.0.0.1:4200,http://localhost:4200
MAX_BODY_BYTES=26214400
RATE_LIMIT_PER_MINUTE=600

# --- evidence storage (local content-addressed store; S3ObjectStore is CONTRACT_ONLY)
OBJECT_STORE_DIR=.local/objects

# --- outbox worker inside the API process (WORKER=off to run it elsewhere)
WORKER=on
WORKER_INTERVAL_MS=500

# --- integration worker service identity (needs adapter.allowlist or policy.configure in the tenant)
WORKER_ACCOUNT_EMAIL=secadmin@empathia-demo.empathia.invalid
WORKER_ACCOUNT_ROLE=secadmin

# --- web app and Python service
WEB_HOST=127.0.0.1
WEB_PORT=4200
API_URL=http://127.0.0.1:4100
INTELLIGENCE_TOKEN=CHANGE_ME

# --- optional S3 profile (docker compose --profile s3)
MINIO_ROOT_USER=empathia
MINIO_ROOT_PASSWORD=CHANGE_ME
