%% Containers of the production starter (services/, apps/, packages/). One modular monolith; Python only for the ML research prototype.
flowchart TB
  subgraph Browser
    WEB[enterprise-web<br/>React + TypeScript]
    STUDIO[founder-studio<br/>local founder hub]
  end
  subgraph API["enterprise-api — TypeScript modular monolith (Node 22)"]
    HTTP[HTTP layer<br/>auth, validation, idempotency, correlation IDs]
    MODS[Modules: tenants · users/roles · sites · rooms · devices · relationships ·<br/>designs/revisions · drawings · commissioning · evidence · issues ·<br/>work orders · notifications · integrations · audit · read models]
    ENGINE[[commissioning-engine<br/>server-side rules]]
    REL[[relationship-engine]]
    WORKER[outbox worker<br/>retries · dead letter]
  end
  PG[(PostgreSQL 16<br/>tenant-scoped schema, RLS,<br/>outbox, audit log)]
  OBJ[(Object storage<br/>local adapter; S3/MinIO contract)]
  PY[intelligence-python<br/>Starlette · synthetic ML prototype]
  WEB --> HTTP
  STUDIO -. health only .-> HTTP
  HTTP --> MODS
  MODS --> ENGINE
  MODS --> REL
  MODS --> PG
  MODS --> OBJ
  WORKER --> PG
  MODS -. optional, labelled synthetic .-> PY
