{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Empathia governed domain event envelope",
  "type": "object",
  "required": [
    "event_id",
    "event_type",
    "schema_version",
    "tenant_id",
    "aggregate_type",
    "aggregate_id",
    "occurred_at",
    "source_provenance",
    "idempotency_key",
    "payload"
  ],
  "properties": {
    "event_id": {
      "type": "string"
    },
    "event_type": {
      "type": "string"
    },
    "schema_version": {
      "type": "string"
    },
    "tenant_id": {
      "type": "string"
    },
    "aggregate_type": {
      "type": "string"
    },
    "aggregate_id": {
      "type": "string"
    },
    "occurred_at": {
      "type": "string",
      "format": "date-time"
    },
    "source_provenance": {
      "type": "object"
    },
    "correlation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "causation_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "authorization_reference": {
      "type": [
        "string",
        "null"
      ]
    },
    "idempotency_key": {
      "type": "string"
    },
    "data_classification": {
      "enum": [
        "PUBLIC",
        "INTERNAL",
        "CONFIDENTIAL",
        "RESTRICTED"
      ]
    },
    "simulation_mode": {
      "enum": [
        "SYNTHETIC",
        "LAB",
        "CUSTOMER_LIVE"
      ]
    },
    "payload": {
      "type": "object"
    }
  }
}