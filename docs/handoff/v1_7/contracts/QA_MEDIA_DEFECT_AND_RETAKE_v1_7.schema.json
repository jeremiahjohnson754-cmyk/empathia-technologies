{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Empathia film defect with timecode and retest",
  "type": "object",
  "required": [
    "defect_id",
    "clip_id",
    "timecode_in",
    "category",
    "severity",
    "symptom",
    "evidence_uri",
    "status"
  ],
  "properties": {
    "defect_id": {
      "type": "string"
    },
    "clip_id": {
      "type": "string"
    },
    "chapter_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scene_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "timecode_in": {
      "type": "string"
    },
    "timecode_out": {
      "type": [
        "string",
        "null"
      ]
    },
    "frame_index": {
      "type": [
        "integer",
        "null"
      ]
    },
    "category": {
      "enum": [
        "UNCANNY_HUMAN",
        "CHARACTER_IDENTITY",
        "ANIMATION_PHYSICS",
        "LIP_SYNC",
        "VOICE_CONTINUITY",
        "AUDIO_MIX",
        "CAPTIONS",
        "ENGINEERING_REALISM",
        "SAFETY",
        "NARRATIVE",
        "VISUAL_TEXT",
        "RIGHTS",
        "ENCODE",
        "ACCESSIBILITY"
      ]
    },
    "severity": {
      "enum": [
        "P0",
        "P1",
        "P2",
        "P3"
      ]
    },
    "symptom": {
      "type": "string"
    },
    "evidence_uri": {
      "type": "string"
    },
    "source_asset_version": {
      "type": [
        "string",
        "null"
      ]
    },
    "fix_commit": {
      "type": [
        "string",
        "null"
      ]
    },
    "new_render_sha256": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "OPEN",
        "FIX_IN_PROGRESS",
        "READY_FOR_RETEST",
        "RETEST_FAIL",
        "PASS_RETEST",
        "WAIVED_P2_P3"
      ]
    },
    "reviewer_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "human_signoff": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}