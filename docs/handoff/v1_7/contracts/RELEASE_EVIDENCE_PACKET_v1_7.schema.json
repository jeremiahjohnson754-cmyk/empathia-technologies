{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Empathia release evidence manifest",
  "type": "object",
  "required": [
    "release_id",
    "repo_commit",
    "release_profile",
    "requirements",
    "qa_results",
    "open_findings",
    "founder_approval",
    "status"
  ],
  "properties": {
    "release_id": {
      "type": "string"
    },
    "repo_commit": {
      "type": "string"
    },
    "release_profile": {
      "type": "string"
    },
    "requirements": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "qa_results": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "test_id",
          "status"
        ],
        "properties": {
          "test_id": {
            "type": "string"
          },
          "status": {
            "enum": [
              "PASS",
              "FAIL",
              "NOT_RUN",
              "BLOCKED"
            ]
          },
          "evidence_uri": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      }
    },
    "open_findings": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "founder_approval": {
      "type": [
        "string",
        "null"
      ]
    },
    "status": {
      "enum": [
        "NOT_READY",
        "READY_FOR_REVIEW",
        "APPROVED_FOR_STAGING",
        "APPROVED_FOR_PRODUCTION"
      ]
    },
    "risk_acceptance": {
      "type": "array",
      "items": {
        "type": "string"
      }
    }
  }
}