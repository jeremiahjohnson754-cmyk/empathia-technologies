{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Empathia SIGNAL canon scene + approved cinematic asset contract",
  "type": "object",
  "required": [
    "chapter_id",
    "scene_id",
    "canon_source_sha256",
    "source_dialogue_ids",
    "decision_ids",
    "character_identities",
    "engineering_review",
    "production_state",
    "media_assets"
  ],
  "properties": {
    "chapter_id": {
      "type": "string"
    },
    "scene_id": {
      "type": "string"
    },
    "canon_source_sha256": {
      "type": "string",
      "pattern": "^[a-f0-9]{64}$"
    },
    "source_dialogue_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "decision_ids": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "character_identities": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "continuity_bible_version": {
      "type": "string"
    },
    "engineering_review": {
      "type": "object",
      "properties": {
        "reviewer": {
          "type": "string"
        },
        "source_logic": {
          "type": "string"
        },
        "safety_rules": {
          "type": "array",
          "items": {
            "type": "string"
          }
        },
        "status": {
          "enum": [
            "NOT_RUN",
            "PASS",
            "FAIL",
            "BLOCKED"
          ]
        }
      },
      "required": [
        "status"
      ]
    },
    "production_state": {
      "enum": [
        "CANON_READ_ONLY",
        "EDITORIAL_PROPOSAL",
        "ANIMATIC",
        "RENDER_PENDING_QA",
        "QA_REJECTED",
        "HUMAN_APPROVED",
        "PUBLISHED"
      ]
    },
    "media_assets": {
      "type": "array",
      "items": {
        "type": "object",
        "required": [
          "asset_id",
          "kind",
          "uri",
          "sha256",
          "rights_status"
        ],
        "properties": {
          "asset_id": {
            "type": "string"
          },
          "kind": {
            "enum": [
              "rig",
              "scene",
              "voice",
              "narration",
              "sfx",
              "score",
              "video_master",
              "video_delivery",
              "caption",
              "transcript",
              "poster",
              "timeline"
            ]
          },
          "uri": {
            "type": "string"
          },
          "sha256": {
            "type": "string"
          },
          "rights_status": {
            "enum": [
              "PENDING",
              "APPROVED",
              "BLOCKED"
            ]
          }
        }
      }
    },
    "qa_results": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "founder_approval_id": {
      "type": [
        "string",
        "null"
      ]
    }
  }
}