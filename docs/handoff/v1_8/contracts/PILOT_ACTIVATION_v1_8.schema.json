{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://spec.empathia.example/schemas/pilot_activation-v1.8.json",
  "title":"Pilot status snapshot v1.8 (illustrative)",
  "type":"object","additionalProperties":false,
  "required":["schema_version","pilot_id","tenant_id","sku","readiness_state","payment_state","entitlement_state","connector_authorization","deployment_state","scope","last_updated_at"],
  "properties":{
    "schema_version":{"const":"1.8"},
    "pilot_id":{"type":"string"},
    "tenant_id":{"type":"string"},
    "sku":{"enum":["PILOT-DISCOVERY","PILOT-READONLY","PILOT-HARDWARE","PILOT-CAMPUS"]},
    "readiness_state":{"enum":["READY_TO_PURCHASE","READY_AFTER_CUSTOMER_ACTION","REQUIRES_SALES_REVIEW","NOT_CURRENTLY_SUPPORTED"]},
    "payment_state":{"enum":["NOT_STARTED","CHECKOUT_STARTED","PENDING","VERIFIED","FAILED","REFUNDED","DISPUTED"]},
    "entitlement_state":{"enum":["NONE","PROVISIONING","ACTIVE","SUSPENDED","EXPIRED","REVOKED"]},
    "connector_authorization":{"enum":["NONE","REQUESTED","APPROVED","DENIED","REVOKED"]},
    "deployment_state":{"enum":["NOT_STARTED","TENANT_READY","IDENTITY_APPROVED","DISCOVERY_IN_PROGRESS","FIRST_SOURCE_VERIFIED","ASSETS_RECONCILED","PILOT_ACTIVE","FIRST_REPORT_DELIVERED","REVIEW_READY","CONVERSION_APPROVED","PILOT_ENDED","BLOCKED"]},
    "scope":{"type":"object","required":["room_limit","site_limit","connector_limit"],"properties":{"room_limit":{"type":"integer","minimum":0},"site_limit":{"type":"integer","minimum":0},"connector_limit":{"type":"integer","minimum":0}},"additionalProperties":false},
    "first_verified_source_event_id":{"type":["string","null"]},
    "blocking_reasons":{"type":"array","items":{"type":"string"}},
    "last_updated_at":{"type":"string","format":"date-time"}
  }
}
