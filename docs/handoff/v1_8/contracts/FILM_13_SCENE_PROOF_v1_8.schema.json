{
  "$schema":"https://json-schema.org/draft/2020-12/schema",
  "$id":"https://spec.empathia.example/schemas/film13-scene-proof-v1.8.json",
  "title":"Flagship Film 13 scene-to-proof ledger v1.8 (illustrative)",
  "type":"object","additionalProperties":false,
  "required":["film_id","scene_id","start_tc","end_tc","asset_context_id","data_class","claim_ids","evidence_ids","rights_status","engineering_review_status","creative_review_status","media_file_state"],
  "properties":{
    "film_id":{"const":"EMPATHIA-FILM-13"},
    "scene_id":{"type":"string"},
    "start_tc":{"type":"string","pattern":"^[0-9]{2}:[0-9]{2}:[0-9]{2}$"},
    "end_tc":{"type":"string","pattern":"^[0-9]{2}:[0-9]{2}:[0-9]{2}$"},
    "asset_context_id":{"type":"string"},
    "data_class":{"enum":["SYNTHETIC","MODELED","LAB","CUSTOMER_AUTHORIZED_SANITIZED"]},
    "claim_ids":{"type":"array","items":{"type":"string"}},
    "evidence_ids":{"type":"array","items":{"type":"string"}},
    "rights_status":{"enum":["NOT_REVIEWED","CLEARED","BLOCKED"]},
    "engineering_review_status":{"enum":["NOT_RUN","PASS","FAIL","BLOCKED"]},
    "creative_review_status":{"enum":["NOT_RUN","PASS","FAIL","BLOCKED"]},
    "media_file_state":{"enum":["CONCEPT","SCRIPT","STORYBOARD","PILOT_RENDER","MASTER_RENDER","QA_APPROVED","PUBLISHED"]},
    "media_file_path":{"type":["string","null"]},
    "review_notes":{"type":"array","items":{"type":"string"}}
  }
}
