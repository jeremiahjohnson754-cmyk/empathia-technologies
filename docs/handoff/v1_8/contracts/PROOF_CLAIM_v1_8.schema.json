{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://spec.empathia.example/schemas/proof_claim-v1.8.json",
  "title": "Empathia proof claim contract v1.8 (illustrative; not deployed endpoint)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "claim_id",
    "capability_id",
    "product",
    "scope",
    "environment",
    "data_kind",
    "verification_state",
    "implementation_revision",
    "verified_at",
    "source_type",
    "evidence_ids",
    "limitations",
    "public_approval",
    "owner"
  ],
  "properties": {
    "schema_version": {
      "const": "1.8"
    },
    "claim_id": {
      "type": "string",
      "minLength": 4,
      "maxLength": 128
    },
    "capability_id": {
      "type": "string",
      "minLength": 2
    },
    "product": {
      "type": "string",
      "minLength": 2
    },
    "world": {
      "type": [
        "string",
        "null"
      ]
    },
    "tenant_id": {
      "type": [
        "string",
        "null"
      ]
    },
    "scope": {
      "enum": [
        "PUBLIC_SANITIZED",
        "TENANT",
        "STAFF"
      ]
    },
    "environment": {
      "enum": [
        "dev",
        "test",
        "staging",
        "production",
        "synthetic_demo"
      ]
    },
    "data_kind": {
      "enum": [
        "SYNTHETIC",
        "MODELED",
        "IMPORTED",
        "LAB_OBSERVED",
        "CUSTOMER_OBSERVED"
      ]
    },
    "verification_state": {
      "enum": [
        "SPECIFIED",
        "SYNTHETIC_DEMO",
        "IMPLEMENTED_NOT_VERIFIED",
        "LAB_VERIFIED",
        "CUSTOMER_AUTHORIZED",
        "LIVE_OBSERVING",
        "DEGRADED",
        "BLOCKED",
        "REVOKED",
        "RELEASED_VERIFIED"
      ]
    },
    "implementation_revision": {
      "type": "string",
      "minLength": 1
    },
    "verification_method": {
      "type": [
        "string",
        "null"
      ]
    },
    "verifier_identity": {
      "type": [
        "string",
        "null"
      ]
    },
    "verified_at": {
      "type": "string",
      "format": "date-time"
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "source_type": {
      "type": "string"
    },
    "source_freshness_at": {
      "type": [
        "string",
        "null"
      ],
      "format": "date-time"
    },
    "evidence_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    },
    "limitations": {
      "type": "array",
      "items": {
        "type": "string"
      }
    },
    "claim_text_public": {
      "type": [
        "string",
        "null"
      ]
    },
    "public_approval": {
      "enum": [
        "NOT_REQUESTED",
        "PENDING",
        "APPROVED",
        "REJECTED",
        "REVOKED"
      ]
    },
    "owner": {
      "type": "string"
    },
    "approved_derivative_ids": {
      "type": "array",
      "uniqueItems": true,
      "items": {
        "type": "string"
      }
    }
  },
  "allOf": [
    {
      "if": {
        "properties": {
          "scope": {
            "const": "PUBLIC_SANITIZED"
          }
        }
      },
      "then": {
        "properties": {
          "tenant_id": {
            "const": null
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "data_kind": {
            "const": "SYNTHETIC"
          }
        }
      },
      "then": {
        "properties": {
          "verification_state": {
            "not": {
              "enum": [
                "LIVE_OBSERVING",
                "LAB_VERIFIED"
              ]
            }
          }
        }
      }
    },
    {
      "if": {
        "properties": {
          "verification_state": {
            "const": "LIVE_OBSERVING"
          }
        }
      },
      "then": {
        "properties": {
          "data_kind": {
            "const": "CUSTOMER_OBSERVED"
          },
          "source_freshness_at": {
            "type": "string",
            "format": "date-time"
          }
        },
        "required": [
          "source_freshness_at"
        ]
      }
    }
  ]
}