node_modules/
dist/
build/
.cache/
*.log
.env
.env.local
# local runtime state (database cluster, object store, studio state)
.local/
# large derived files regenerated by scripts (see docs/discovery/README.md)
docs/discovery/FILE_INVENTORY.csv
__pycache__/
*.pyc

# large test fixtures and screenshots are regenerated by the tests
tests/evidence/**/fixtures/
tests/evidence/**/*.png
apps/founder-studio/src/generated/
# ML: regenerated byte-for-byte by ml/datasets/generate_synthetic.mjs and ml/training/train.py
ml/datasets/*.csv
ml/models/*.joblib
# rendered media: regenerate with scripts/media/*.mjs (hashes are in each RENDER_MANIFEST.json)
media/renders/**/*.mp4
media/renders/**/slides/
media/renders/**/mermaid-config.json
releases/handoff/out/
legacy/source/**/*.html
legacy/source/**/*.js
legacy/source/**/*.map
legacy/source/**/*.css
!legacy/source/SHA256SUMS.txt
legacy/baseline/**/*.png
