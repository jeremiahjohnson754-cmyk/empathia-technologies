node_modules/
dist/
/build/
# a bare "build/" rule once hid apps/demo/src/build (Build a Room source) from every commit and package; source is never ignored by a bare name
!**/src/build/
.cache/
*.log
.env
.env.local
# local runtime state (database cluster, object store, studio state)
.local/
# large derived files regenerated by scripts (see docs/discovery/README.md)
docs/discovery/FILE_INVENTORY.csv
__pycache__/
*.pyc

# large test fixtures and screenshots are regenerated by the tests
tests/evidence/**/fixtures/
tests/evidence/**/*.png
apps/founder-studio/src/generated/
# ML: regenerated byte-for-byte by ml/datasets/generate_synthetic.mjs and ml/training/train.py
ml/datasets/*.csv
ml/models/*.joblib
# rendered media: regenerate with scripts/media/*.mjs (hashes are in each RENDER_MANIFEST.json)
media/renders/**/*.mp4
media/renders/**/slides/
media/renders/**/mermaid-config.json
releases/handoff/out/
legacy/source/**/*.html
legacy/source/**/*.js
legacy/source/**/*.map
legacy/source/**/*.css
!legacy/source/SHA256SUMS.txt
legacy/baseline/**/*.png
apps/demo/src/generated/
releases/source/

# derived release stamp (scripts/build.mjs)
apps/enterprise-web/src/generated/

# website film renditions: only a film VERIFIED for the website is committed (apps/website/films.json); the founder portrait and the
# product captures (dark demo screenshots, hashes in apps/website/media/product/PROVENANCE.json) are committed
apps/website/media/*
!apps/website/media/founder/
!apps/website/media/product/
# the Collabora-SING film's web renditions (about 4 MB; docs/media/COLLABORA_SING_FILM.md): the site is built from the repository, and the build stops when a VERIFIED film's files are missing
!apps/website/media/SYNCLAB/
# the home page film M2 (about 15 MB; owner verified 2026-11-13, apps/website/films.json)
!apps/website/media/M2/
# the short scenes (about 15 MB; owner verified 2026-11-13, apps/website/broll.json) and every film the owner verified that day
!apps/website/media/broll/
!apps/website/media/FA/
!apps/website/media/F02P/
!apps/website/media/IE/
!apps/website/media/F01/
!apps/website/media/V141R/
!apps/website/media/W2/
# the product demonstration films, recorded from the demonstration (scripts/media/record-product-film.mjs)
!apps/website/media/P-*/
# the guides as printed booklets (scripts/media/make-booklets.mjs; hashes in BOOKLETS.json)
!apps/website/media/booklets/
# the founder's keepsake photograph (founder page, 2026-11-13)
!apps/website/media/keepsake/
.claude/

# regenerated by browser runs; tracked evidence stays tracked, new run output is not committed (REBUILD_COMMON)
tests/evidence/

# rendered new films are delivered, not committed (rebuild with media/films-new/*/render.sh)
media/films-new/*/out/*.mp4
media/signal/s01/film/composites/
media/signal/s01/film/src/
