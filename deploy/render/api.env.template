# Render staging — empathia-staging-api (image-backed web service). Enter these in the Render dashboard (Environment), marking every
# SECRET value as a secret. Placeholders only: no real value belongs in this repository.
NODE_ENV=production
RELEASE_ENVIRONMENT=staging
AUTH_MODE=oidc
OIDC_ISSUER=<https issuer of your identity provider>
OIDC_AUDIENCE=<the API audience registered at the provider, e.g. api://empathia-staging>
OIDC_JWKS_URL=<https JWKS URL of the provider>
OIDC_LINK_BY_EMAIL=on
# SECRET — openssl rand -base64 48 (the API still signs short-lived internal tokens; 32 bytes minimum)
JWT_SECRET=<secret>
# SECRET — Render Postgres INTERNAL URL of the default user (the schema owner; migrations and the operator bootstrap only)
DATABASE_URL=postgres://<default_user>:<password>@<internal-host>/<db>?sslmode=require
# SECRET — same host and database, the runtime roles created by deploy/render/bootstrap-roles.sql
APP_DATABASE_URL=postgres://empathia_app:<EMPATHIA_APP_PASSWORD>@<internal-host>/<db>?sslmode=require
WORKER_DATABASE_URL=postgres://empathia_worker:<EMPATHIA_WORKER_PASSWORD>@<internal-host>/<db>?sslmode=require
CORS_ORIGINS=https://<empathia-staging-web>.onrender.com
TRUSTED_PROXY=on
WORKER=on
RATE_LIMIT_PER_MINUTE=600
DB_STATEMENT_TIMEOUT_MS=15000
WORKER_STATEMENT_TIMEOUT_MS=60000
NODE_OPTIONS=--max-old-space-size=384
LOG_LEVEL=info
# Error telemetry stays off until the Sentry account setup is authorized (then TELEMETRY=sentry and SENTRY_DSN as a secret)
TELEMETRY=none
# Set by the image: HOST=0.0.0.0, OBJECT_STORE_DIR=/data/objects (the persistent disk), RELEASE_SHA=<commit>. PORT is set by Render.
# Service settings (not variables): pre-deploy command  node services/enterprise-api/dist/src/db/migrate.js
#                                   health check path   /health
#                                   persistent disk     /data/objects, 1 GB
