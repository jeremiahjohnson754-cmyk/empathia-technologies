# empathia-api — the environment the Blueprint (deploy/render/enterprise.render.yaml) declares, for creating the service by hand instead.
# Placeholders only: no real value belongs in this repository. Mark every SECRET as a secret. Runbook: docs/operations/RENDER_DEPLOYMENT.md.
# SECRET — the database's INTERNAL connection string (the schema owner, empathia_owner): pre-deploy steps and operator bootstrap only
DATABASE_URL=postgres://empathia_owner:<password>@<internal-host>/empathia
# SECRET — runtime role passwords (>= 24 characters; openssl rand -base64 36). The API derives the empathia_app / empathia_worker URLs
# from DATABASE_URL + these; the pre-deploy step `bootstrap.js --roles` creates the roles with them. (APP_DATABASE_URL and
# WORKER_DATABASE_URL, if set, take precedence — users must be empathia_app / empathia_worker.)
EMPATHIA_APP_PASSWORD=<secret>
EMPATHIA_WORKER_PASSWORD=<secret>
# SECRET — openssl rand -base64 48 (>= 32 bytes)
JWT_SECRET=<secret>
PGSSLMODE=require
NODE_ENV=production
RELEASE_ENVIRONMENT=staging
AUTH_MODE=oidc
OIDC_ISSUER=<https issuer of your identity provider>
OIDC_AUDIENCE=<the API audience registered at the provider, e.g. api://empathia-staging>
OIDC_JWKS_URL=<https JWKS URL of the provider>
OIDC_LINK_BY_EMAIL=on
CORS_ORIGINS=https://empathia-app.onrender.com
TRUSTED_PROXY=on
WORKER=on
RATE_LIMIT_PER_MINUTE=600
DB_STATEMENT_TIMEOUT_MS=15000
WORKER_STATEMENT_TIMEOUT_MS=60000
NODE_OPTIONS=--max-old-space-size=384
LOG_LEVEL=info
# Error telemetry stays off until the Sentry account setup is authorized (then TELEMETRY=sentry and SENTRY_DSN as a secret)
TELEMETRY=none
# Set by the image: HOST=0.0.0.0, OBJECT_STORE_DIR=/data/objects. Set by Render: PORT, RENDER_GIT_COMMIT (reported as the release).
# Service settings (not variables): Docker, Dockerfile ./deploy/render/Dockerfile, context .
#   start        node services/enterprise-api/dist/src/main.js
#   pre-deploy   node services/enterprise-api/dist/src/db/bootstrap.js --roles && node services/enterprise-api/dist/src/db/migrate.js && node services/enterprise-api/dist/src/db/bootstrap.js --policy
#   health       /health          disk   /data/objects, 1 GB
