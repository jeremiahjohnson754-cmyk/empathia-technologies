{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1ProofClaims/0.1.0.json",
  "title": "POST /v1/proof/claims request body",
  "description": "Record a claim (tenant claims: security admin; public claims: the founder organization). A claim always starts unpublished; audited",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "claim_id",
    "capability_id",
    "product",
    "scope",
    "environment",
    "data_kind",
    "verification_state",
    "implementation_revision",
    "verified_at",
    "source_type",
    "evidence_ids",
    "limitations",
    "owner"
  ],
  "properties": {
    "claim_id": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]{3,127}$"
    },
    "capability_id": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "product": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "world": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "scope": {
      "type": "string",
      "enum": [
        "PUBLIC_SANITIZED",
        "TENANT",
        "STAFF"
      ]
    },
    "environment": {
      "type": "string",
      "enum": [
        "dev",
        "test",
        "staging",
        "production",
        "synthetic_demo"
      ]
    },
    "data_kind": {
      "type": "string",
      "enum": [
        "SYNTHETIC",
        "MODELED",
        "IMPORTED",
        "LAB_OBSERVED",
        "CUSTOMER_OBSERVED"
      ]
    },
    "verification_state": {
      "type": "string",
      "enum": [
        "SPECIFIED",
        "SYNTHETIC_DEMO",
        "IMPLEMENTED_NOT_VERIFIED",
        "LAB_VERIFIED",
        "CUSTOMER_AUTHORIZED",
        "LIVE_OBSERVING",
        "DEGRADED",
        "BLOCKED",
        "REVOKED",
        "RELEASED_VERIFIED"
      ]
    },
    "implementation_revision": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "verification_method": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 400
    },
    "verifier_identity": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 200
    },
    "verified_at": {
      "type": "string",
      "maxLength": 40
    },
    "expires_at": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "source_type": {
      "type": "string",
      "minLength": 1,
      "maxLength": 200
    },
    "source_freshness_at": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 40
    },
    "evidence_ids": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "approved_derivative_ids": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 160
      }
    },
    "limitations": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "string",
        "minLength": 1,
        "maxLength": 400
      }
    },
    "claim_text_public": {
      "type": [
        "string",
        "null"
      ],
      "maxLength": 1200
    },
    "owner": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
