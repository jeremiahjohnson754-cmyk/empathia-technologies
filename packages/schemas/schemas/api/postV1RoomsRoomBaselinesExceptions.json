{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1RoomsRoomBaselinesExceptions/0.1.0.json",
  "title": "POST /v1/rooms/{room}/baselines/exceptions request body",
  "description": "Request an exception against the current baseline (decided by a different person)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "dimension",
    "rationale"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "ACCEPTED_DEVIATION",
        "TEMPORARY_WAIVER",
        "KNOWN_GAP"
      ]
    },
    "dimension": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "rationale": {
      "type": "string",
      "minLength": 5,
      "maxLength": 4000
    },
    "expiresAt": {
      "type": "string",
      "maxLength": 40
    }
  }
}
