{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1AdminMembershipsRevoke/0.1.0.json",
  "title": "POST /v1/admin/memberships/revoke request body",
  "description": "Revoke a membership (never your own)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "personId",
    "roleKey"
  ],
  "properties": {
    "personId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "roleKey": {
      "type": "string",
      "pattern": "^[a-z_]{2,40}$"
    }
  }
}
