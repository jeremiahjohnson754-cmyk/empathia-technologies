{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1RoomsRoomMeasurementsImport/0.1.0.json",
  "title": "POST /v1/rooms/{room}/measurements/import request body",
  "description": "Import an instrument export (CSV evidence already uploaded): every row validated, all-or-nothing; each value FIELD_MEASURED and traceable to the file SHA-256 and row, the instrument, its calibration certificate and due date (CALIBRATED only when measured on or before it), method and uncertainty. dryRun checks without writing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "evidenceId",
    "instrumentId",
    "calibrationRef",
    "calibrationDue",
    "method"
  ],
  "properties": {
    "evidenceId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "instrumentId": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "instrumentModel": {
      "type": "string",
      "maxLength": 120
    },
    "calibrationRef": {
      "type": "string",
      "minLength": 2,
      "maxLength": 120
    },
    "calibrationDue": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "method": {
      "type": "string",
      "minLength": 2,
      "maxLength": 80
    },
    "uncertainty": {
      "type": "number",
      "minimum": 0
    },
    "uncertaintyUnit": {
      "type": "string",
      "maxLength": 20
    },
    "dryRun": {
      "type": "boolean"
    }
  }
}
