{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1Competencies/0.1.0.json",
  "title": "POST /v1/competencies request body",
  "description": "Record a credential for a person (PENDING_VERIFICATION; counts for nothing until verified). Training records may be cited as supporting evidence of an assessment, never as the credential itself",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "personId",
    "competency",
    "source",
    "issuer",
    "reference",
    "issuedOn",
    "expiresOn"
  ],
  "properties": {
    "personId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "competency": {
      "type": "string",
      "pattern": "^[a-z]+\\.[a-z_]+$"
    },
    "source": {
      "type": "string",
      "enum": [
        "EXTERNAL_CERTIFICATE",
        "LICENCE",
        "ASSESSMENT"
      ]
    },
    "issuer": {
      "type": "string",
      "minLength": 2,
      "maxLength": 160
    },
    "reference": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "issuedOn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "expiresOn": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}$"
    },
    "evidenceId": {
      "type": "string",
      "pattern": "^[0-9a-fA-F-]{36}$"
    },
    "trainingRefs": {
      "type": "array",
      "maxItems": 20,
      "items": {
        "type": "integer",
        "minimum": 1
      }
    }
  }
}
