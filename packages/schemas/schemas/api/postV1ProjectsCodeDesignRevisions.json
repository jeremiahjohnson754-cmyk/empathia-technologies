{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1ProjectsCodeDesignRevisions/0.1.0.json",
  "title": "POST /v1/projects/{code}/design-revisions request body",
  "description": "Collaborative design: propose a design revision (files and/or the project room’s Lite model, DIVR, needed domain reviews); supersedes the one in review",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason"
  ],
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 3,
      "maxLength": 1000
    },
    "files": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "name"
        ],
        "properties": {
          "name": {
            "type": "string",
            "minLength": 1,
            "maxLength": 200
          },
          "kind": {
            "type": "string",
            "maxLength": 40
          },
          "sha256": {
            "type": "string",
            "pattern": "^[0-9a-f]{64}$"
          }
        }
      }
    },
    "liteModelRoom": {
      "type": "string",
      "maxLength": 40
    },
    "divr": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "intent",
        "verificationPlan"
      ],
      "properties": {
        "intent": {
          "type": "string",
          "minLength": 5,
          "maxLength": 2000
        },
        "verificationPlan": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "string",
            "maxLength": 400
          }
        }
      }
    },
    "domainsNeeded": {
      "type": "array",
      "items": {
        "type": "string",
        "enum": [
          "dsp",
          "camera",
          "touch"
        ]
      }
    }
  }
}
