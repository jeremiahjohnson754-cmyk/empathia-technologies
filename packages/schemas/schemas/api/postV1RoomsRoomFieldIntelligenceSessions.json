{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1RoomsRoomFieldIntelligenceSessions/0.1.0.json",
  "title": "POST /v1/rooms/{room}/field-intelligence/sessions request body",
  "description": "Propose a session: measurement points and the tests with their adapters (systems engineering)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "points",
    "tests"
  ],
  "properties": {
    "points": {
      "type": "array",
      "minItems": 1,
      "maxItems": 20,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,20}$"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          }
        }
      }
    },
    "tests": {
      "type": "array",
      "minItems": 1,
      "maxItems": 10,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": [
          "id",
          "label",
          "adapter"
        ],
        "properties": {
          "id": {
            "type": "string",
            "pattern": "^[A-Za-z0-9-]{1,20}$"
          },
          "label": {
            "type": "string",
            "maxLength": 80
          },
          "adapter": {
            "type": "string",
            "pattern": "^ADP-[A-Z]{3}$"
          }
        }
      }
    }
  }
}
