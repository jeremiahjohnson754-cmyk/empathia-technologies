{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1MeasurementsIdVerify/0.1.0.json",
  "title": "POST /v1/measurements/{id}/verify request body",
  "description": "Verify or reject a measurement (verifier ≠ recorder; only a FIELD_MEASURED value from a CALIBRATED instrument is ever VERIFIED)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "VERIFIED",
        "REJECTED"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
