{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1FirmwareBaselines/0.1.0.json",
  "title": "POST /v1/firmware-baselines request body",
  "description": "Propose the firmware version approved for a model (a model with a unit on record)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "model",
    "version"
  ],
  "properties": {
    "model": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "version": {
      "type": "string",
      "minLength": 1,
      "maxLength": 40
    },
    "note": {
      "type": "string",
      "maxLength": 500
    }
  }
}
