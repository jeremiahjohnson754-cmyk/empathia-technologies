{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1FounderDecisionsIdTransition/0.1.0.json",
  "title": "POST /v1/founder/decisions/{id}/transition request body",
  "description": "Move a decision (DRAFT→DECIDED|WITHDRAWN, DECIDED→REVISITED|WITHDRAWN, REVISITED→DECIDED|WITHDRAWN) with a rationale: appends an immutable revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "to",
    "rationale"
  ],
  "properties": {
    "to": {
      "type": "string",
      "enum": [
        "DECIDED",
        "REVISITED",
        "WITHDRAWN"
      ]
    },
    "rationale": {
      "type": "string",
      "minLength": 1,
      "maxLength": 8000
    },
    "options": {
      "type": "array",
      "items": {
        "type": "object",
        "description": ""
      }
    }
  }
}
