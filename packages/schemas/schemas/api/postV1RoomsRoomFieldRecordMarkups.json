{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1RoomsRoomFieldRecordMarkups/0.1.0.json",
  "title": "POST /v1/rooms/{room}/field-record/markups request body",
  "description": "Pin a note to the plan (the installation team and the approvers)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "x",
    "y",
    "text"
  ],
  "properties": {
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "text": {
      "type": "string",
      "minLength": 1,
      "maxLength": 1000
    }
  }
}
