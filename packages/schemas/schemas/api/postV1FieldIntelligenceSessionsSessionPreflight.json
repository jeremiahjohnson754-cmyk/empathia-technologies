{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1FieldIntelligenceSessionsSessionPreflight/0.1.0.json",
  "title": "POST /v1/field-intelligence/sessions/{session}/preflight request body",
  "description": "One step of the safety preflight (protocol · window · operator · instrument · estop), each by its own authority; some failures end the session; the response lists what is still missing",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "step"
  ],
  "properties": {
    "step": {
      "type": "string",
      "enum": [
        "protocol",
        "window",
        "operator",
        "instrument",
        "estop"
      ]
    },
    "levelLimit": {
      "type": "number"
    },
    "occupied": {
      "type": "boolean"
    },
    "from": {
      "type": "string",
      "maxLength": 40
    },
    "privacyNotice": {
      "type": "boolean"
    },
    "present": {
      "type": "boolean"
    },
    "qualified": {
      "type": "boolean"
    },
    "mfa": {
      "type": "boolean"
    },
    "instrument": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "model",
        "serial",
        "calibrationId",
        "calibrationDue"
      ],
      "properties": {
        "model": {
          "type": "string",
          "maxLength": 80
        },
        "serial": {
          "type": "string",
          "maxLength": 80
        },
        "calibrationId": {
          "type": "string",
          "maxLength": 80
        },
        "calibrationDue": {
          "type": "string",
          "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
        }
      }
    },
    "verified": {
      "type": "boolean"
    }
  }
}
