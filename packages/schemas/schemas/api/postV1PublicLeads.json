{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1PublicLeads/0.1.0.json",
  "title": "POST /v1/public/leads request body",
  "description": "A message from the public website (demonstration request, pilot partnership, contact): stored for a person to answer; stricter per-address budget; honeypot; minimum fill time; consent required",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "kind",
    "name",
    "organization",
    "email",
    "message",
    "consent",
    "elapsedMs"
  ],
  "properties": {
    "kind": {
      "type": "string",
      "enum": [
        "demo",
        "pilot",
        "contact"
      ]
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    },
    "organization": {
      "type": "string",
      "minLength": 1,
      "maxLength": 160
    },
    "email": {
      "type": "string",
      "minLength": 3,
      "maxLength": 200
    },
    "audience": {
      "type": "string",
      "maxLength": 80
    },
    "scope": {
      "type": "string",
      "maxLength": 80
    },
    "message": {
      "type": "string",
      "minLength": 1,
      "maxLength": 4000
    },
    "consent": {
      "type": "boolean"
    },
    "website": {
      "type": "string",
      "maxLength": 200
    },
    "elapsedMs": {
      "type": "integer",
      "minimum": 0,
      "maximum": 86400000
    }
  }
}
