{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1RoomsRoomDevices/0.1.0.json",
  "title": "POST /v1/rooms/{room}/devices request body",
  "description": "Add a planned device (gets a tenant-unique canonical asset id)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "category"
  ],
  "properties": {
    "category": {
      "type": "string",
      "maxLength": 20
    },
    "x": {
      "type": "number"
    },
    "y": {
      "type": "number"
    },
    "mount": {
      "type": "string",
      "enum": [
        "wall",
        "ceiling",
        "floor",
        "table",
        "rack"
      ]
    },
    "rot": {
      "type": "number"
    }
  }
}
