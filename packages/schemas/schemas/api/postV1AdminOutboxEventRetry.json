{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1AdminOutboxEventRetry/0.1.0.json",
  "title": "POST /v1/admin/outbox/{event}/retry request body",
  "description": "Retry a dead-lettered event (security admin)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "reason"
  ],
  "properties": {
    "reason": {
      "type": "string",
      "minLength": 5,
      "maxLength": 1000,
      "pattern": "\\S",
      "description": "why the event is replayed (recorded in the Evidence Ledger with the prior attempts and last error)"
    }
  }
}
