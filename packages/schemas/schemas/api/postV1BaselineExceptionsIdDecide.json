{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1BaselineExceptionsIdDecide/0.1.0.json",
  "title": "POST /v1/baseline-exceptions/{id}/decide request body",
  "description": "Approve or reject a baseline exception (never the requester)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "REJECTED"
      ]
    },
    "note": {
      "type": "string",
      "maxLength": 2000
    }
  }
}
