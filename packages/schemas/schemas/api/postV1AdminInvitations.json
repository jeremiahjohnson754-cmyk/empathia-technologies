{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1AdminInvitations/0.1.0.json",
  "title": "POST /v1/admin/invitations request body",
  "description": "Invite a person into your organization with a role and optional site scope; the one-time token is returned once (founder role only in the founder organization; never architect)",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "email",
    "roleKey"
  ],
  "properties": {
    "email": {
      "type": "string",
      "maxLength": 200,
      "pattern": "^[^@\\s]+@[^@\\s]+$"
    },
    "roleKey": {
      "type": "string",
      "pattern": "^[a-z_]{2,40}$"
    },
    "siteCodes": {
      "type": "array",
      "maxItems": 50,
      "items": {
        "type": "string",
        "maxLength": 24
      }
    },
    "days": {
      "type": "integer",
      "minimum": 1,
      "maximum": 30
    }
  }
}
