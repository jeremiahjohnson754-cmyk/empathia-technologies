{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1WorkOrdersWorkOrderTriage/0.1.0.json",
  "title": "POST /v1/work-orders/{workOrder}/triage request body",
  "description": "Triage (OPEN or REOPENED → TRIAGED): severity sets the SLA; scope and risk are recorded",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "severity",
    "scope",
    "risk"
  ],
  "properties": {
    "severity": {
      "type": "string",
      "enum": [
        "Mission critical",
        "High",
        "Standard"
      ]
    },
    "scope": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "risk": {
      "type": "string",
      "minLength": 1,
      "maxLength": 500
    },
    "workType": {
      "type": "string",
      "enum": [
        "camera_replacement",
        "dsp_upgrade",
        "new_install",
        "network_change",
        "break_fix",
        "room_verification"
      ]
    },
    "window": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "from"
      ],
      "properties": {
        "from": {
          "type": "string",
          "format": "date-time"
        },
        "to": {
          "type": "string",
          "format": "date-time"
        }
      }
    }
  }
}
