{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1Projects/0.1.0.json",
  "title": "POST /v1/projects request body",
  "description": "Create a project",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "code",
    "name"
  ],
  "properties": {
    "code": {
      "type": "string",
      "pattern": "^PRJ-[A-Z0-9-]{2,32}$"
    },
    "name": {
      "type": "string",
      "minLength": 1,
      "maxLength": 120
    }
  }
}
