{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/api/postV1ProjectsCodeDecision/0.1.0.json",
  "title": "POST /v1/projects/{code}/decision request body",
  "description": "Approval: the selected approver (or a valid delegate) approves, holds (reason + review date) or rejects (reason) the named scope revision",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "decision",
    "scopeRev"
  ],
  "properties": {
    "decision": {
      "type": "string",
      "enum": [
        "APPROVED",
        "HELD",
        "REJECTED"
      ]
    },
    "scopeRev": {
      "type": "integer",
      "minimum": 1
    },
    "reason": {
      "type": "string",
      "maxLength": 2000
    },
    "reviewDate": {
      "type": "string",
      "pattern": "^\\d{4}-\\d{2}-\\d{2}$"
    }
  }
}
