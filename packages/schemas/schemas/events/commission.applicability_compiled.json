{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/events/commission.applicability_compiled/1.0.0.json",
  "title": "commission.applicability_compiled",
  "type": "object",
  "required": [
    "id",
    "type",
    "schemaVersion",
    "tenantId",
    "aggregateType",
    "aggregateId",
    "aggregateRevision",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "commission.applicability_compiled"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actorId": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "designId",
        "applicable"
      ],
      "properties": {
        "designId": {
          "not": {
            "type": "null"
          }
        },
        "applicable": {
          "not": {
            "type": "null"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
