{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://schemas.empathia.invalid/events/control.design_rolled_back/1.0.0.json",
  "title": "control.design_rolled_back",
  "type": "object",
  "required": [
    "id",
    "type",
    "schemaVersion",
    "tenantId",
    "aggregateType",
    "aggregateId",
    "aggregateRevision",
    "occurredAt",
    "correlationId",
    "payload"
  ],
  "properties": {
    "id": {
      "type": "string",
      "minLength": 1
    },
    "type": {
      "const": "control.design_rolled_back"
    },
    "schemaVersion": {
      "type": "string",
      "pattern": "^1\\.\\d+\\.\\d+$"
    },
    "tenantId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateType": {
      "type": "string",
      "minLength": 1
    },
    "aggregateId": {
      "type": "string",
      "minLength": 1
    },
    "aggregateRevision": {
      "type": "integer",
      "minimum": 0
    },
    "occurredAt": {
      "type": "string",
      "format": "date-time"
    },
    "actorId": {
      "type": [
        "string",
        "null"
      ]
    },
    "correlationId": {
      "type": "string",
      "minLength": 1
    },
    "causationId": {
      "type": [
        "string",
        "null"
      ]
    },
    "payload": {
      "type": "object",
      "required": [
        "roomId",
        "fromVersionId",
        "toVersionId"
      ],
      "properties": {
        "roomId": {
          "not": {
            "type": "null"
          }
        },
        "fromVersionId": {
          "not": {
            "type": "null"
          }
        },
        "toVersionId": {
          "not": {
            "type": "null"
          }
        }
      },
      "additionalProperties": true
    }
  },
  "additionalProperties": false
}
