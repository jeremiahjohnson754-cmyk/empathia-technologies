{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "empathia.dossier/1",
  "title": "Empathia demonstration dossier",
  "description": "The JSON file of an Empathia demonstration export: the report's tables and structured entities, with provenance and a SHA-256 of the body. Synthetic data only.",
  "type": "object",
  "required": ["schema", "exportId", "kind", "title", "subtitle", "scope", "status", "generatedAt", "generatedAs", "build", "provenance", "headline", "kpis", "tables", "entities", "integrity"],
  "additionalProperties": false,
  "properties": {
    "schema": { "const": "empathia.dossier/1" },
    "exportId": { "type": "string", "minLength": 3 },
    "kind": { "type": "string", "pattern": "^[a-z][a-z0-9-]*$" },
    "title": { "type": "string", "minLength": 1 },
    "subtitle": { "type": "string" },
    "scope": {
      "type": "object", "additionalProperties": false,
      "required": ["tenant", "site", "building", "floor", "room", "roomId"],
      "properties": { "tenant": { "type": "string" }, "site": { "type": "string" }, "building": { "type": "string" }, "floor": { "type": "string" }, "room": { "type": "string" }, "roomId": { "type": "string" } }
    },
    "status": {
      "type": "object", "additionalProperties": false, "required": ["label", "tone", "why"],
      "properties": { "label": { "type": "string" }, "tone": { "enum": ["ok", "warn", "bad", "muted"] }, "why": { "type": "string" } }
    },
    "generatedAt": { "type": "string", "format": "date-time" },
    "generatedAs": { "type": "string", "minLength": 1 },
    "build": { "type": "string" },
    "provenance": { "type": "array", "minItems": 1, "items": { "type": "string", "minLength": 1 } },
    "headline": { "type": "string" },
    "kpis": {
      "type": "array",
      "items": { "type": "object", "required": ["label", "value"], "additionalProperties": false, "properties": { "label": { "type": "string" }, "value": { "type": "string" }, "note": { "type": "string" } } }
    },
    "tables": {
      "type": "object",
      "additionalProperties": {
        "type": "object", "required": ["columns", "rows", "note"], "additionalProperties": false,
        "properties": {
          "columns": { "type": "array", "items": { "type": "object", "required": ["key", "label", "kind"], "additionalProperties": false, "properties": { "key": { "type": "string" }, "label": { "type": "string" }, "kind": { "enum": ["text", "number", "date", "status"] } } } },
          "rows": { "type": "array", "items": { "type": "object", "additionalProperties": { "type": ["string", "number", "null"] } } },
          "note": { "type": ["string", "null"] }
        }
      }
    },
    "entities": { "type": "object" },
    "integrity": {
      "type": "object", "required": ["algorithm", "of", "value"], "additionalProperties": false,
      "properties": { "algorithm": { "const": "SHA-256" }, "of": { "type": "string" }, "value": { "type": "string", "pattern": "^[0-9a-f]{64}$" } }
    }
  }
}
